            {
              "name": "page",
              "in": "query",
              "description": "Número da página (inicia em 0)",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 0
              }
            },
            {
              "name": "size",
              "in": "query",
              "description": "Tamanho da página",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 20
              }
            },
            {
              "name": "sort",
              "in": "query",
              "description": "Campo para ordenação",
              "required": false,
              "schema": {
                "type": "string",
                "default": "name"
              }
            },
            {
              "name": "direction",
              "in": "query",
              "description": "Direção da ordenação (ASC ou DESC)",
              "required": false,
              "schema": {
                "type": "string",
                "default": "ASC"
              }
            }
          ],
          "responses": {
            "403": {
              "description": "Sem permissão para visualizar salas",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/PageRoomResponse"
                  }
                }
              }
            },
            "401": {
              "description": "Não autenticado",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/PageRoomResponse"
                  }
                }
              }
            },
            "200": {
              "description": "Lista de salas retornada com sucesso",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/PageRoomResponse"
                  }
                }
              }
            }
          },
          "security": [
            {
              "JWT": []
            }
          ]
        },
        "post": {
