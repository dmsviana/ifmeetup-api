      "/rooms/available": {
        "get": {
          "tags": [
            "Salas"
          ],
          "summary": "Buscar salas disponíveis em período",
          "description": "Retorna lista de salas disponíveis em um período específico (sem conflitos de horário)",
          "operationId": "getAvailableRooms",
          "parameters": [
            {
              "name": "startDateTime",
              "in": "query",
              "description": "Data/hora de início (formato ISO 8601)",
              "required": true,
              "schema": {
                "type": "string",
                "format": "date-time"
              },
              "example": "2025-07-20T10:00:00"
            },
            {
              "name": "endDateTime",
              "in": "query",
              "description": "Data/hora de término (formato ISO 8601)",
              "required": true,
              "schema": {
                "type": "string",
                "format": "date-time"
              },
              "example": "2025-07-20T12:00:00"
            }
          ],
          "responses": {
            "403": {
              "description": "Sem permissão para visualizar disponibilidade",
              "content": {
                "*/*": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/RoomResponse"
                    }
                  }
                }
              }
            },
            "400": {
              "description": "Período inválido",
              "content": {
                "*/*": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/RoomResponse"
                    }
                  }
                }
              }
            },
            "401": {
              "description": "Não autenticado",
              "content": {
                "*/*": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/RoomResponse"
                    }
                  }
                }
              }
            },
            "200": {
              "description": "Lista de salas disponíveis retornada com sucesso",
              "content": {
                "*/*": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/RoomResponse"
                    }
                  }
                }
              }
            }
          },
          "security": [
            {
              "JWT": []
            }
          ]
        }
      },
      "/auth/verify": {
        "get": {
          "tags": [
            "Autenticação"
          ],
          "summary": "Verificação de conta",
          "description": "Verifica uma conta de usuário usando um token enviado por email",
          "operationId": "verifyAccount",
          "parameters": [
            {
              "name": "token",
              "in": "query",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Conta verificada com sucesso",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/AuthResponse"
                  }
                }
              }
            },
            "422": {
              "description": "Token inválido ou expirado",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/AuthResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/auth/me": {
        "get": {
          "tags": [
            "Autenticação"
          ],
          "summary": "Obter usuário atual",
          "description": "Retorna os dados do usuário atualmente autenticado",
          "operationId": "me",
          "responses": {
            "200": {
              "description": "Dados do usuário recuperados com sucesso",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/AuthResponse"
                  }
                }
              }
            },
            "401": {
              "description": "Usuário não autenticado",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/AuthResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "RoomRequest": {
          "required": [
            "capacity",
            "name",
            "status",
            "type"
          ],
          "type": "object",
          "properties": {
            "name": {
              "maxLength": 100,
              "minLength": 3,
              "type": "string",
              "description": "Nome da sala",
              "example": "Laboratório de Informática 01"
            },
            "location": {
              "maxLength": 255,
              "minLength": 0,
              "type": "string",
              "description": "Localização da sala",
              "example": "Bloco D, 2º andar"
            },
            "capacity": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
              "description": "Capacidade máxima de pessoas",
              "format": "int32",
              "example": 40
            },
            "type": {
              "type": "string",
              "description": "Tipo da sala",
              "example": "LABORATORY",
              "enum": [
                "CLASSROOM",
                "AUDITORIUM",
                "LABORATORY",
                "MEETING_ROOM",
                "SHARED_SPACE",
                "OTHER"
              ]
            },
            "status": {
              "type": "string",
              "description": "Status operacional da sala",
              "example": "AVAILABLE",
              "enum": [
                "AVAILABLE",
                "UNAVAILABLE",
                "UNDER_MAINTENANCE",
                "DISABLED"
              ]
            },
            "description": {
              "maxLength": 1000,
              "minLength": 0,
              "type": "string",
              "description": "Descrição adicional da sala",
              "example": "Laboratório equipado com 40 computadores e projetor"
            },
            "resources": {
              "uniqueItems": true,
              "type": "array",
              "description": "Recursos disponíveis na sala",
              "items": {
                "$ref": "#/components/schemas/RoomResourceRequest"
              }
            }
          },
          "description": "Dados para criação ou atualização de sala"
        },
        "RoomResourceRequest": {
          "required": [
            "quantity",
            "resourceType"
          ],
          "type": "object",
          "properties": {
            "resourceType": {
              "type": "string",
              "description": "Tipo do recurso",
              "example": "PROJECTOR",
              "enum": [
                "PROJECTOR",
                "COMPUTER",
                "WHITEBOARD",
                "SOUND_SYSTEM",
                "AIR_CONDITIONING",
                "PRINTER",
                "VIDEO_CONFERENCE_SYSTEM",
                "OTHER"
              ]
            },
            "quantity": {
              "maximum": 999,
              "minimum": 0,
              "type": "integer",
              "description": "Quantidade disponível",
              "format": "int32",
              "example": 2
            },
            "details": {
              "maxLength": 255,
              "minLength": 0,
              "type": "string",
              "description": "Detalhes adicionais do recurso",
              "example": "Projetor Epson 3000 lumens"
            }
          },
          "description": "Dados de um recurso disponível na sala"
        },
        "RoomResourceResponse": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Identificador único do recurso",
              "format": "uuid"
            },
            "resourceType": {
              "type": "string",
              "description": "Tipo do recurso",
              "enum": [
                "PROJECTOR",
                "COMPUTER",
                "WHITEBOARD",
                "SOUND_SYSTEM",
                "AIR_CONDITIONING",
                "PRINTER",
                "VIDEO_CONFERENCE_SYSTEM",
                "OTHER"
              ]
            },
            "quantity": {
              "type": "integer",
              "description": "Quantidade disponível",
              "format": "int32"
            },
            "details": {
              "type": "string",
              "description": "Detalhes adicionais do recurso"
            }
          },
          "description": "Resposta com dados de recurso da sala"
        },
        "RoomResponse": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Identificador único da sala",
              "format": "uuid"
            },
            "name": {
              "type": "string",
              "description": "Nome da sala"
            },
            "location": {
              "type": "string",
              "description": "Localização da sala"
            },
            "capacity": {
              "type": "integer",
              "description": "Capacidade máxima de pessoas",
              "format": "int32"
            },
            "type": {
              "type": "string",
              "description": "Tipo da sala",
              "enum": [
                "CLASSROOM",
                "AUDITORIUM",
                "LABORATORY",
                "MEETING_ROOM",
                "SHARED_SPACE",
                "OTHER"
              ]
            },
            "status": {
              "type": "string",
              "description": "Status operacional da sala",
              "enum": [
                "AVAILABLE",
                "UNAVAILABLE",
                "UNDER_MAINTENANCE",
                "DISABLED"
              ]
            },
            "description": {
              "type": "string",
              "description": "Descrição adicional da sala"
            },
            "resources": {
              "uniqueItems": true,
              "type": "array",
              "description": "Recursos disponíveis na sala",
              "items": {
                "$ref": "#/components/schemas/RoomResourceResponse"
              }
            },
            "createdBy": {
              "type": "string",
              "description": "Nome do usuário que criou a sala"
            },
            "updatedBy": {
              "type": "string",
              "description": "Nome do último usuário que atualizou a sala"
            },
            "createdAt": {
              "type": "string",
              "description": "Data e hora de criação",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "description": "Data e hora da última atualização",
              "format": "date-time"
            }
          },
          "description": "Resposta com dados da sala"
        },
        "PasswordResetRequest": {
          "required": [
            "newPassword",
            "token"
          ],
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "description": "Token de redefinição recebido por email",
              "example": "a1b2c3d4-5678-90ab-cdef-ghijklmnopqr"
            },
            "newPassword": {
              "maxLength": 2147483647,
              "minLength": 8,
              "type": "string",
              "description": "Nova senha (mínimo 8 caracteres)",
              "writeOnly": true,
              "example": "novaSenhaSecreta123"
            }
          },
          "description": "Dados para redefinição de senha"
        },
        "AuthResponse": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "description": "Mensagem informativa sobre o resultado da operação"
            },
            "user": {
              "$ref": "#/components/schemas/UserResponse"
            },
            "sessionId": {
              "type": "string",
              "description": "Identificador único da sessão, quando aplicável",
              "format": "uuid"
            },
            "expiresAt": {
              "type": "string",
              "description": "Data e hora de expiração da sessão, quando aplicável",
              "format": "date-time"
            },
            "token": {
              "type": "string",
              "description": "Token JWT de autenticação, quando aplicável"
            }
          },
          "description": "Resposta padrão para operações de autenticação"
        },
        "UserResponse": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Identificador único do usuário",
              "format": "uuid"
            },
            "name": {
              "type": "string",
              "description": "Nome completo do usuário"
            },
            "email": {
              "type": "string",
              "description": "Email do usuário"
            },
            "phoneNumber": {
              "type": "string",
              "description": "Número de telefone do usuário"
            },
            "roles": {
              "uniqueItems": true,
              "type": "array",
              "description": "Lista de papéis/roles do usuário no sistema",
              "items": {
                "type": "string",
                "description": "Lista de papéis/roles do usuário no sistema"
              }
            }
          },
          "description": "Resposta com dados básicos do usuário"
        },
        "RegisterRequest": {
          "required": [
            "email",
            "firstName",
            "lastName",
            "password",
            "profileType"
          ],
          "type": "object",
          "properties": {
            "firstName": {
              "maxLength": 50,
              "minLength": 2,
              "type": "string",
              "description": "Nome do usuário",
              "example": "Maria"
            },
            "lastName": {
              "maxLength": 50,
              "minLength": 2,
              "type": "string",
              "description": "Sobrenome do usuário",
              "example": "Silva"
            },
            "email": {
              "type": "string",
              "description": "Email do usuário",
              "example": "maria.silva@exemplo.com"
            },
            "phoneNumber": {
              "pattern": "^\\(?\\d{2}\\)?[\\s-]?\\d{4,5}-?\\d{4}$",
              "type": "string",
              "description": "Número de telefone do usuário",
              "example": "(83) 99999-9999"
            },
            "password": {
              "maxLength": 2147483647,
              "minLength": 8,
              "type": "string",
              "description": "Senha do usuário (mínimo 8 caracteres)",
              "writeOnly": true,
              "example": "senhaSecreta123"
            },
            "profileType": {
              "type": "string",
              "description": "Tipo de perfil do usuário",
              "example": "STUDENT",
              "enum": [
                "ADMIN",
                "COORDINATOR",
                "TEACHER",
                "STUDENT"
              ]
            }
          },
          "description": "Dados para registro de novo usuário"
        },
        "LoginRequest": {
          "required": [
            "email",
            "password"
          ],
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "description": "Email do usuário",
              "example": "usuario@exemplo.com"
            },
            "password": {
              "type": "string",
              "description": "Senha do usuário",
              "writeOnly": true,
              "example": "senhaSecreta123"
            }
          },
          "description": "Dados para autenticação de usuário"
        },
        "ForgotPasswordRequest": {
          "required": [
            "email"
          ],
          "type": "object",
          "properties": {
            "email": {
              "type": "string"
            }
          }
        },
        "RoomStatusRequest": {
          "required": [
            "status"
          ],
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Novo status da sala",
              "example": "UNDER_MAINTENANCE",
              "enum": [
                "AVAILABLE",
                "UNAVAILABLE",
                "UNDER_MAINTENANCE",
                "DISABLED"
              ]
            },
            "reason": {
              "type": "string",
              "description": "Motivo da mudança de status",
              "example": "Manutenção preventiva dos equipamentos"
            }
          },
          "description": "Dados para alteração de status da sala"
        },
        "PageRoomResponse": {
          "type": "object",
          "properties": {
            "totalPages": {
              "type": "integer",
              "format": "int32"
            },
            "totalElements": {
              "type": "integer",
              "format": "int64"
            },
            "pageable": {
              "$ref": "#/components/schemas/PageableObject"
            },
            "first": {
              "type": "boolean"
            },
            "last": {
              "type": "boolean"
            },
            "size": {
              "type": "integer",
              "format": "int32"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/RoomResponse"
              }
            },
            "number": {
              "type": "integer",
              "format": "int32"
            },
            "sort": {
              "$ref": "#/components/schemas/SortObject"
            },
            "numberOfElements": {
              "type": "integer",
              "format": "int32"
            },
            "empty": {
              "type": "boolean"
            }
          }
        },
        "PageableObject": {
          "type": "object",
          "properties": {
            "paged": {
              "type": "boolean"
            },
            "pageNumber": {
              "type": "integer",
              "format": "int32"
            },
            "pageSize": {
              "type": "integer",
              "format": "int32"
            },
            "unpaged": {
              "type": "boolean"
            },
            "offset": {
              "type": "integer",
              "format": "int64"
            },
            "sort": {
              "$ref": "#/components/schemas/SortObject"
            }
          }
        },
        "SortObject": {
          "type": "object",
          "properties": {
            "sorted": {
              "type": "boolean"
            },
            "unsorted": {
              "type": "boolean"
            },
            "empty": {
              "type": "boolean"
            }
          }
        }
      },
      "securitySchemes": {
        "JWT": {
          "type": "http",
          "description": "JWT token para autenticação",
          "scheme": "bearer",
          "bearerFormat": "JWT"
        }
      }
    }
  }